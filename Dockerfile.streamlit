# Production Streamlit UI Container for Mine Dust Analysis Platform
# Inherits from base image to reuse installed python dependencies
FROM mine-dust-api:latest

WORKDIR /app

# Copy application UI code
COPY app/ ./app/

# Default API endpoint URL inside Docker network
ENV API_BASE_URL=http://api:8000

# Expose Streamlit UI port
EXPOSE 8501

# Health check endpoint verification
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Start Streamlit application
CMD ["streamlit", "run", "app/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
