# Python / Byte-compiled
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Build & packaging
build/
dist/
*.egg-info/
.eggs/

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.token

# Logs & temp files
logs/*.log
!logs/.gitkeep
*.tmp
*.temp

# Pipeline & Model Artifacts
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
artifacts/metrics/*
!artifacts/metrics/.gitkeep
artifacts/datasets/*
!artifacts/datasets/.gitkeep

# Raw / confidential client data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Notebook checkpoints
.ipynb_checkpoints/
